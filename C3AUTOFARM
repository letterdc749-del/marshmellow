local function buyByText(searchText)
    for _=1,40 do
        for _,v in ipairs(LP.PlayerGui:GetDescendants()) do
            if v:IsA("TextButton") and v.Visible then
                local btnText=v.Text:split("\n")[1]:upper():gsub("%s+","")
                local search=searchText:upper():gsub("%s+","")
                if btnText==search or v.Text:upper():find(search,1,true) then
                    pcall(function() v.MouseButton1Click:Fire() end)
                    pcall(function()
                        local pos=v.AbsolutePosition+v.AbsoluteSize*0.5
                        VIM:SendMouseButtonEvent(pos.X,pos.Y,0,true,game,1)
                        task.wait(0.05)
                        VIM:SendMouseButtonEvent(pos.X,pos.Y,0,false,game,1)
                    end)
                    unequipAll(); return true
                end
            end
        end
        task.wait(0.1)
    end
    return false
end

doBuy = function()
    directTP(SELLER_POS); task.wait(1)
    setStatus("buying supplies...")
    if countInv("Water")==0 then setStatus("buying water..."); buyByText("Water"); task.wait(0.5) end
    if countInv("Sugar Block Bag")==0 then setStatus("buying sugar block bag..."); buyByText("Sugar Block Bag"); task.wait(0.5) end
    if countInv("Gelatin")==0 then setStatus("buying gelatin..."); buyByText("Gelatin"); task.wait(0.5) end
    unequipAll()
    setStatus("bought — W:"..countInv("Water").." S:"..countInv("Sugar Block Bag").." G:"..countInv("Gelatin"))
end

-- ── WATCHDOG ──────────────────────────────────────────────────
local function startWatchdog()
    if watchThread then task.cancel(watchThread); watchThread=nil end
    watchThread=task.spawn(function()
        while farmEnabled do
            task.wait(5); if not farmEnabled then break end
            if tick()-lastStatusChange>CFG.watchdogSec then
                setStatus("watchdog restart!"); playErrorSound(); task.wait(1)
                if farmThread then task.cancel(farmThread); farmThread=nil end
                stats.cookStart=nil; stats.stepEnd=nil; lastStatusChange=tick()
                farmThread=task.spawn(function()
                    while farmEnabled do
                        local ok=doCook()
                        if not ok and farmEnabled then task.wait(2) end
                        if loopEnabled and farmEnabled then doSell(); doBuy() end
                        task.wait(0.3)
                    end
                    setStatus("idle")
                end)
            end
        end
    end)
end

-- ── STOP / START ──────────────────────────────────────────────
local function stopFarm()
    if stats.farmStarted then stats.farmUptime+=tick()-stats.farmStarted; stats.farmStarted=nil end
    farmEnabled=false; loopEnabled=false
    if farmThread  then task.cancel(farmThread);  farmThread=nil  end
    if watchThread then task.cancel(watchThread); watchThread=nil end
    stopMicroMove(); stats.cookStart=nil; stats.stepEnd=nil
    setStatus("idle")
end

local function startFarm()
    stopFarm(); farmEnabled=true; stats.farmStarted=tick()
    setPromptSettings(100,false)
    if CFG.autoUG then goUnderground() end
    startMicroMove(); startWatchdog(); lastStatusChange=tick()
    farmThread=task.spawn(function()
        while farmEnabled do
            local ok=doCook()
            if not ok and farmEnabled then task.wait(2) end
            task.wait(0.3)
        end
        setStatus("idle"); stopMicroMove()
    end)
end

local function startLoop()
    stopFarm(); farmEnabled=true; loopEnabled=true; stats.farmStarted=tick()
    setPromptSettings(100,false)
    if CFG.autoUG then goUnderground() end
    startMicroMove(); startWatchdog(); lastStatusChange=tick()
    farmThread=task.spawn(function()
        if countInv("Water")==0 or countInv("Sugar Block Bag")==0 or countInv("Gelatin")==0 then doBuy() end
        while farmEnabled do
            local ok=doCook()
            if not farmEnabled then break end
            if not ok then task.wait(2); doBuy()
                if savedCookPos and farmEnabled then directTP(savedCookPos); task.wait(0.5) end
                continue
            end
            doSell(); if not farmEnabled then break end
            doBuy()
            if savedCookPos and farmEnabled then setStatus("returning to cook spot..."); directTP(savedCookPos); task.wait(0.5) end
            task.wait(0.3)
        end
        setStatus("idle"); stopMicroMove()
    end)
end

