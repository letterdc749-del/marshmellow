local doSell, doBuy

-- ── COOK CYCLE ────────────────────────────────────────────────
local function doCook()
    stats.cookStart=tick()
    local function fail(msg) playErrorSound(); setStatus(msg); stats.failed+=1; stats.cookStart=nil; return false end

    -- Save cook position so we can return after selling/buying
    local char=LP.Character; local root=char and char:FindFirstChild("HumanoidRootPart")
    if root then savedCookPos=root.Position end

    -- Auto-restock if missing ingredients before starting
    local needRestock = countInv("Water")==0 or countInv("Sugar Block Bag")==0 or countInv("Gelatin")==0
    if needRestock then
        -- Sell any marshmallows we have before buying
        local bags = getMarshmallows()
        if #bags > 0 then
            setStatus("⚠ Out of ingredients — selling first...")
            doSell()
            if not farmEnabled then stats.cookStart=nil; return false end
        end
        setStatus("⚠ Buying ingredients...")
        doBuy()
        if not farmEnabled then stats.cookStart=nil; return false end
        -- Return to cook spot after buying
        if savedCookPos then directTP(savedCookPos); task.wait(0.5) end
    end

    -- Step 1: Water
    setStatus("Equipping Water...")
    if not equipWithRetry("Water") then return fail("❌ No Water!") end
    jitter(); pressE(); task.spawn(function() task.wait(0.3); refreshInv() end)
    setStatus("⏳ Water cooking ("..CFG.waterWait.."s)")
    waitI(CFG.waterWait)
    if not farmEnabled then stats.cookStart=nil; return false end

    -- Step 2: Sugar Block Bag
    setStatus("Equipping Sugar Block Bag...")
    if equipWithRetry("Sugar Block Bag") then
        jitter(); pressE(); task.spawn(function() task.wait(0.3); refreshInv() end)
        setStatus("⏳ Sugar animation ("..CFG.sugarWait.."s)")
        waitI(CFG.sugarWait)
        if not farmEnabled then stats.cookStart=nil; return false end
    end

    -- Step 3: Gelatin
    setStatus("Equipping Gelatin...")
    if equipWithRetry("Gelatin") then
        jitter(); pressE(); task.spawn(function() task.wait(0.3); refreshInv() end)
        setStatus("⏳ Cooking ("..CFG.gelatinWait.."s)")
        waitI(CFG.gelatinWait)
        if not farmEnabled then stats.cookStart=nil; return false end
    end

    -- Step 4: Empty Bag — wait up to 6s for it
    setStatus("Waiting for Empty Bag...")
    local w=0
    while w<6 and farmEnabled do
        if LP.Backpack:FindFirstChild("Empty Bag") or (LP.Character and LP.Character:FindFirstChild("Empty Bag")) then break end
        task.wait(0.5); w+=0.5
    end
    if not farmEnabled then stats.cookStart=nil; return false end
    if not LP.Backpack:FindFirstChild("Empty Bag") and not (LP.Character and LP.Character:FindFirstChild("Empty Bag")) then
        return fail("⚠ No Empty Bag!")
    end

    -- Snapshot counts BEFORE pressing E
    setStatus("Collecting marshmallow...")
    local function countWord(word)
        local n=0
        local function scan(c) if not c then return end
            for _,v in ipairs(c:GetChildren()) do
                if v:IsA("Tool") and v.Name:lower():find(word) then n+=1 end
            end
        end
        scan(LP.Backpack); if LP.Character then scan(LP.Character) end
        return n
    end

    local preSm=countWord("small"); local preMd=countWord("medium"); local preLg=countWord("large")

    if equipWithRetry("Empty Bag") then
        jitter(); pressE()
        task.wait(2) -- wait for bag to land in inventory
    end

    -- Check what changed by scanning for the words small/medium/large
    local diffLg=countWord("large")-preLg
    local diffMd=countWord("medium")-preMd
    local diffSm=countWord("small")-preSm

    local gotSize=nil
    if diffLg>0 then gotSize="Large"
    elseif diffMd>0 then gotSize="Medium"
    elseif diffSm>0 then gotSize="Small" end

    -- Last resort: just find any marshmallow tool and read name directly
    if not gotSize then
        local function scanAny(c) if not c then return end
            for _,v in ipairs(c:GetChildren()) do
                if v:IsA("Tool") then
                    local n=v.Name:lower()
                    if n:find("marshmallow") or n:find("marsh") then
                        if n:find("large") then gotSize="Large"
                        elseif n:find("medium") then gotSize="Medium"
                        elseif n:find("small") then gotSize="Small" end
                        stats.lastBatch=v.Name; return
                    end
                end
            end
        end
        scanAny(LP.Backpack); if not gotSize and LP.Character then scanAny(LP.Character) end
    end

    if gotSize then
        if gotSize=="Large" then stats.large+=1
        elseif gotSize=="Medium" then stats.medium+=1
        else stats.small+=1 end
        logBatch(gotSize)
        task.wait(0.5) -- wait for marshmallow to actually land in backpack
        setStatus("✅ Got "..gotSize.." MS!")
    else
        setStatus("⚠ Collected (unknown size)")
        stats.small+=1; logBatch("?")
    end

    stats.batches+=1
    -- Track average cook time
    if stats.cookStart then
        stats.totalCookSecs += tick()-stats.cookStart
        stats.cookCount += 1
    end
    stats.cookStart=nil

    -- Discord webhook every N batches
    if stats.batches%CFG.webhookBatches==0 then
        sendWebhook("🍡 "..stats.batches.." batches done!")
    end

    return true
end

-- ── SELL ──────────────────────────────────────────────────────
doSell = function()
    local totalBefore=countMarshmallowInv()
    if totalBefore==0 then setStatus("Nothing to sell"); return end
    selling = true -- block watcher
    directTP(SELLER_POS); task.wait(0.6)
    local sold=0
    local ms=getMarshmallows()
    while #ms>0 do
        local item=ms[1]
        -- Determine size and price BEFORE selling
        local itemName=item.Name
        local sz=getSizeFromName(itemName)
        local price=PRICES[sz] or PRICES.Small
        -- Equip the item
        local hum=LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
        if item.Parent~=LP.Character and hum then
            pcall(function() hum:EquipTool(item) end)
            task.wait(0.1)
        end
        if item.Parent~=LP.Character then
            pcall(function() item.Parent=LP.Character end)
            task.wait(0.1)
        end
        local countBefore=countMarshmallowInv()
        pressE()
        task.wait(0.35)
        local countAfter=countMarshmallowInv()
        -- Only credit if bag actually left inventory
        if countAfter < countBefore then
            stats.earned+=price
            sold+=1
        end
        ms=getMarshmallows()
        if not farmEnabled and sold>0 then break end
    end
    local actuallySold=totalBefore-countMarshmallowInv()
    setStatus("sold "..actuallySold.." bag"..(actuallySold~=1 and "s" or ""))
    unequipAll()
    selling = false -- allow watcher again
end

-- ── BUY ───────────────────────────────────────────────────────
local function buyByText(searchText)
    for _=1,40 do
        for _,v in ipairs(LP.PlayerGui:GetDescendants()) do
            if v:IsA("TextButton") and v.Visible then
                -- Match just the first line of the button text (e.g. "Gelatin" not "Gelatin\n$70")
                local btnText = v.Text:split("\n")[1]:upper():gsub("%s+","")
                local search  = searchText:upper():gsub("%s+","")
                if btnText==search or v.Text:upper():find(search,1,true) then
                    pcall(function() v.MouseButton1Click:Fire() end)
                    pcall(function()
                        local pos=v.AbsolutePosition+v.AbsoluteSize*0.5
                        VIM:SendMouseButtonEvent(pos.X,pos.Y,0,true,game,1)
                        task.wait(0.05)
                        VIM:SendMouseButtonEvent(pos.X,pos.Y,0,false,game,1)
                    end)
                    unequipAll()
                    return true
                end
            end
        end
        task.wait(0.1)
    end
    return false
end

doBuy = function()
    directTP(SELLER_POS); task.wait(1) -- wait for shop GUI to open on its own
    setStatus("Buying supplies...")

    if countInv("Water")==0 then
        setStatus("Buying Water...")
        buyByText("Water"); task.wait(0.5)
    end
    if countInv("Sugar Block Bag")==0 then
        setStatus("Buying Sugar Block Bag...")
        buyByText("Sugar Block Bag"); task.wait(0.5)
    end
    if countInv("Gelatin")==0 then
        setStatus("Buying Gelatin...")
        buyByText("Gelatin"); task.wait(0.5)
    end

    unequipAll()
    setStatus("Bought — W:"..countInv("Water").." S:"..countInv("Sugar Block Bag").." G:"..countInv("Gelatin"))
end

-- ── WATCHDOG ──────────────────────────────────────────────────
local function startWatchdog()
    if watchThread then task.cancel(watchThread); watchThread=nil end
    watchThread=task.spawn(function()
        while farmEnabled do
            task.wait(5)
            if not farmEnabled then break end
            local stuck=tick()-lastStatusChange
            if stuck>CFG.watchdogSec then
                setStatus("🔄 Watchdog restart!")
                playErrorSound()
                task.wait(1)
                -- Cancel and restart farm
                if farmThread then task.cancel(farmThread); farmThread=nil end
                stats.cookStart=nil; stats.stepEnd=nil
                lastStatusChange=tick()
                farmThread=task.spawn(function()
                    while farmEnabled do
                        local ok=doCook()
                        if not ok and farmEnabled then task.wait(2) end
                        if loopEnabled and farmEnabled then
                            doSell(); doBuy()
                        end
                        task.wait(0.3)
                    end
                    setStatus("Idle")
                end)
            end
        end
    end)
end

-- ── STOP ──────────────────────────────────────────────────────
local function stopFarm()
    if stats.farmStarted then
        stats.farmUptime += tick()-stats.farmStarted
        stats.farmStarted=nil
    end
    farmEnabled=false; loopEnabled=false
    if farmThread  then task.cancel(farmThread);  farmThread=nil  end
    if watchThread then task.cancel(watchThread); watchThread=nil end
    stopMicroMove()
    stats.cookStart=nil; stats.stepEnd=nil
    setStatus("Idle")
end

-- ── START FARM (cook only) ────────────────────────────────────
local function startFarm()
    stopFarm(); farmEnabled=true
    stats.farmStarted=tick()
    setPromptSettings(100,false)
    if CFG.autoUG then goUnderground() end
    startMicroMove(); startWatchdog()
    lastStatusChange=tick()
    farmThread=task.spawn(function()
        while farmEnabled do
            local ok=doCook()
            if not ok and farmEnabled then task.wait(2) end
            task.wait(0.3)
        end
        setStatus("Idle"); stopMicroMove()
    end)
end

-- ── START LOOP (cook → sell → buy → repeat) ──────────────────
local function startLoop()
    stopFarm(); farmEnabled=true; loopEnabled=true
    stats.farmStarted=tick()
    setPromptSettings(100,false)
    if CFG.autoUG then goUnderground() end
    startMicroMove(); startWatchdog()
    lastStatusChange=tick()
    farmThread=task.spawn(function()
        -- Buy if missing ingredients
        if countInv("Water")==0 or countInv("Sugar Block Bag")==0 or countInv("Gelatin")==0 then
            doBuy()
        end
        while farmEnabled do
            local ok=doCook()
            if not farmEnabled then break end
            if not ok then task.wait(2); doBuy()
                if savedCookPos and farmEnabled then directTP(savedCookPos); task.wait(0.5) end
                continue
            end
            doSell()
            if not farmEnabled then break end
            doBuy()
            -- Return to cook spot after buying
            if savedCookPos and farmEnabled then
                setStatus("Returning to cook spot...")
                directTP(savedCookPos); task.wait(0.5)
            end
            task.wait(0.3)
        end
        setStatus("Idle"); stopMicroMove()
    end)
end

-- Death recovery
LP.CharacterAdded:Connect(function(char)
    if ugPlatform then ugPlatform:Destroy(); ugPlatform=nil end; isUG=false
    if antiDeath then
        task.wait(0.5)
        local hum=char:FindFirstChildOfClass("Humanoid")
        if hum then pcall(function() hum.MaxHealth=math.huge; hum.Health=math.huge end) end
    end
    -- If farm was running, wait for character to load then continue
