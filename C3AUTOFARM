-- ── COOK CYCLE ────────────────────────────────────────────────
local function doCook()
    stats.cookStart=tick()
    local function fail(msg)
        playErrorSound(); setStatus(msg); stats.failed+=1; stats.cookStart=nil; return false
    end

    local char=LP.Character; local root=char and char:FindFirstChild("HumanoidRootPart")
    if root then savedCookPos=root.Position end

    -- restock if needed
    local needRestock=countInv("Water")==0 or countInv("Sugar Block Bag")==0 or countInv("Gelatin")==0
    if needRestock then
        local bags=getMarshmallows()
        if #bags>0 then
            setStatus("out of ingredients — selling first...")
            doSell()
            if not farmEnabled then stats.cookStart=nil; return false end
        end
        setStatus("buying ingredients...")
        doBuy()
        if not farmEnabled then stats.cookStart=nil; return false end
        if savedCookPos then directTP(savedCookPos); task.wait(0.5) end
    end

    -- Step 1: Water
    setStatus("equipping water...")
    if not equipWithRetry("Water") then return fail("no water!") end
    jitter(); pressE(); task.spawn(function() task.wait(0.3); refreshInv() end)
    setStatus("water cooking ("..CFG.waterWait.."s)")
    waitI(CFG.waterWait)
    if not farmEnabled then stats.cookStart=nil; return false end

    -- Step 2: Sugar Block Bag
    setStatus("equipping sugar block bag...")
    if equipWithRetry("Sugar Block Bag") then
        jitter(); pressE(); task.spawn(function() task.wait(0.3); refreshInv() end)
        setStatus("sugar animation ("..CFG.sugarWait.."s)")
        waitI(CFG.sugarWait)
        if not farmEnabled then stats.cookStart=nil; return false end
    end

    -- Step 3: Gelatin
    setStatus("equipping gelatin...")
    if equipWithRetry("Gelatin") then
        jitter(); pressE(); task.spawn(function() task.wait(0.3); refreshInv() end)
        setStatus("cooking ("..CFG.gelatinWait.."s)")
        waitI(CFG.gelatinWait)
        if not farmEnabled then stats.cookStart=nil; return false end
    end

    -- Step 4: Empty Bag
    setStatus("waiting for empty bag...")
    local w=0
    while w<6 and farmEnabled do
        if LP.Backpack:FindFirstChild("Empty Bag") or (LP.Character and LP.Character:FindFirstChild("Empty Bag")) then break end
        task.wait(0.5); w+=0.5
    end
    if not farmEnabled then stats.cookStart=nil; return false end
    if not LP.Backpack:FindFirstChild("Empty Bag") and not (LP.Character and LP.Character:FindFirstChild("Empty Bag")) then
        return fail("no empty bag!")
    end

    -- Snapshot before collecting
    setStatus("collecting marshmallow...")
    local function countWord(word)
        local n=0
        local function scan(c) if not c then return end
            for _,v in ipairs(c:GetChildren()) do
                if v:IsA("Tool") and v.Name:lower():find(word) then n+=1 end
            end
        end
        scan(LP.Backpack); if LP.Character then scan(LP.Character) end
        return n
    end
    local preSm=countWord("small"); local preMd=countWord("medium"); local preLg=countWord("large")

    if equipWithRetry("Empty Bag") then
        jitter(); pressE(); task.wait(2)
    end

    local diffLg=countWord("large")-preLg
    local diffMd=countWord("medium")-preMd
    local diffSm=countWord("small")-preSm
    local gotSize=nil
    if diffLg>0 then gotSize="Large"
    elseif diffMd>0 then gotSize="Medium"
    elseif diffSm>0 then gotSize="Small" end

    if not gotSize then
        local function scanAny(c) if not c then return end
            for _,v in ipairs(c:GetChildren()) do
                if v:IsA("Tool") then
                    local n=v.Name:lower()
                    if n:find("marshmallow") or n:find("marsh") then
                        if n:find("large") then gotSize="Large"
                        elseif n:find("medium") then gotSize="Medium"
                        else gotSize="Small" end
                        stats.lastBatch=v.Name; return
                    end
                end
            end
        end
        scanAny(LP.Backpack); if not gotSize and LP.Character then scanAny(LP.Character) end
    end

    if gotSize then
        if gotSize=="Large" then stats.large+=1
        elseif gotSize=="Medium" then stats.medium+=1
        else stats.small+=1 end
        stats.batches=stats.small+stats.medium+stats.large
        logBatch(gotSize)
        task.wait(0.5)
        setStatus("cooked "..gotSize:lower().." ms!")
    else
        setStatus("collected (unknown size)")
        stats.small+=1
        stats.batches=stats.small+stats.medium+stats.large
        logBatch("?")
    end

    if stats.cookStart then
        stats.totalCookSecs+=tick()-stats.cookStart
        stats.cookCount+=1
    end
    stats.cookStart=nil

    if stats.batches%CFG.webhookBatches==0 then
        sendWebhook("batch #"..stats.batches.." done!")
    end
    return true
end

-- ── SELL ──────────────────────────────────────────────────────
doSell = function()
    local bags=getMarshmallows()
    if #bags==0 then setStatus("nothing to sell"); return end
    selling=true
    directTP(SELLER_POS); task.wait(0.6)
    local soldCount=0; local earnedThisSell=0
    local toSell=getMarshmallows()
    for _,item in ipairs(toSell) do
        local inBP=item.Parent==LP.Backpack
        local inChar=LP.Character and item.Parent==LP.Character
        if not inBP and not inChar then continue end
        local sz=getSizeFromName(item.Name)
        local price=PRICES[sz] or PRICES.Small
        local hum=LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
        if hum and item.Parent~=LP.Character then
            pcall(function() hum:EquipTool(item) end); task.wait(0.2)
        end
        pressE()
        local gone=false
        for _=1,15 do
            task.wait(0.1)
            if item.Parent~=LP.Backpack and not (LP.Character and item.Parent==LP.Character) then
                gone=true; break
            end
        end
        if gone then
            stats.earned+=price; earnedThisSell+=price; soldCount+=1
            if sz=="Large" then stats.large=math.max(0,stats.large-1)
            elseif sz=="Medium" then stats.medium=math.max(0,stats.medium-1)
            else stats.small=math.max(0,stats.small-1) end
            stats.batches=stats.small+stats.medium+stats.large
            logBatch("sold")
            setStatus("sold "..sz:lower().." ms +$"..price)
        end
        task.wait(0.1)
    end
    unequipAll(); selling=false
    if soldCount>0 then
        setStatus("sold "..soldCount.." bag"..(soldCount~=1 and "s" or "").." +$"..earnedThisSell)
    else
        setStatus("nothing sold")
    end
end

