task.spawn(function()
    while SG.Parent do
        local now=tick()
        lStatus.Text="status: "..stats.status
        if stats.stepEnd then
            local rem=math.max(0,stats.stepEnd-now)
            local pct=math.floor((1-rem/math.max(stats.stepTotal,1))*100)
            lTimer.Text=string.format("step:   %.1fs [%d%%]",rem,pct)
            lTimer.TextColor3=rem<5 and RED or YELLOW
        else lTimer.Text="step:   --"; lTimer.TextColor3=YELLOW end
        if stats.cookStart then
            local e=math.floor(now-stats.cookStart)
            lCookTime.Text=string.format("cook:   %d:%02d",math.floor(e/60),e%60)
        else lCookTime.Text="cook:   --" end
        if stats.cookCount>0 then
            local avg=math.floor(stats.totalCookSecs/stats.cookCount)
            lAvgCook.Text=string.format("avg:    %d:%02d",math.floor(avg/60),avg%60)
        else lAvgCook.Text="avg:    --" end
        local s=math.floor(stats.farmUptime+(stats.farmStarted and tick()-stats.farmStarted or 0))
        lSession.Text=string.format("uptime: %d:%02d",math.floor(s/60),s%60)
        -- keep batches always synced
        local b=stats.small+stats.medium+stats.large
        stats.batches=b
        lBatches.Text ="done:   "..b
        lEarned.Text  ="earned: $"..stats.earned
        lSmall.Text   ="small:  "..stats.small
        lMedium.Text  ="medium: "..stats.medium
        lLarge.Text   ="large:  "..stats.large
        lInBag.Text   ="in bag: "..countMarshmallowInv()
        lLastBag.Text ="last:   "..(stats.lastBatch~="" and stats.lastBatch or "--")
        if #stats.batchLog>0 then lLog.Text="log:    "..table.concat(stats.batchLog," ") end
        refreshInv()
        task.wait(0.2)
    end
end)

-- ── RECORDER PAGE ─────────────────────────────────────────────
local WATCH_KEYS={
    Enum.KeyCode.W,Enum.KeyCode.A,Enum.KeyCode.S,Enum.KeyCode.D,
    Enum.KeyCode.Space,Enum.KeyCode.LeftShift,Enum.KeyCode.E,Enum.KeyCode.F,
    Enum.KeyCode.One,Enum.KeyCode.Two,Enum.KeyCode.Three,Enum.KeyCode.Four,
}
local Rec={Recording=false,Playing=false,Frames={},Conn=nil,PlayIdx=0,Repeating=false,RepeatCount=1,CurrentRep=0,PrevHeld={}}
local function fireKey(down,kc) pcall(function() VIM:SendKeyEvent(down,kc,false,game) end) end
local function releaseAllKeys()
    for _,kc in ipairs(WATCH_KEYS) do fireKey(false,kc) end
    pcall(function() local mp=UIS:GetMouseLocation(); VIM:SendMouseButtonEvent(mp.X,mp.Y,0,false,game,0) end)
    Rec.PrevHeld={}
end
local recStatusLbl=mkLbl(RECORDER_PAGE,"idle",MUTE,1)
local recFramesLbl=mkLbl(RECORDER_PAGE,"0 frames",MUTE,2)
local function updRecStatus()
    if Rec.Recording then recStatusLbl.Text="recording"; recStatusLbl.TextColor3=RED; recFramesLbl.Text=#Rec.Frames.." frames"
    elseif Rec.Playing then recStatusLbl.Text="playing"; recStatusLbl.TextColor3=GREEN; recFramesLbl.Text="frame "..Rec.PlayIdx.."/"..#Rec.Frames
    else recStatusLbl.Text="idle"; recStatusLbl.TextColor3=MUTE; recFramesLbl.Text=#Rec.Frames.." frames saved" end
end
local function stopAll()
    Rec.Recording=false; Rec.Playing=false; Rec.Repeating=false
    if Rec.Conn then Rec.Conn:Disconnect(); Rec.Conn=nil end
    releaseAllKeys(); updRecStatus()
end
local recBtn=mkBtn(RECORDER_PAGE,"record",DKGREY,3)
recBtn.MouseButton1Click:Connect(function()
    if Rec.Recording then
        Rec.Recording=false; if Rec.Conn then Rec.Conn:Disconnect(); Rec.Conn=nil end
        recBtn.Text="record"; recBtn.BackgroundColor3=DKGREY; updRecStatus()
    else
        stopAll(); Rec.Frames={}; Rec.Recording=true
        recBtn.Text="stop recording"; recBtn.BackgroundColor3=RED
        Rec.Conn=RunService.RenderStepped:Connect(function()
            if not Rec.Recording then return end
            local held={}
            for _,kc in ipairs(WATCH_KEYS) do held[kc]=UIS:IsKeyDown(kc) end
            held["MB1"]=UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)
            local mp=UIS:GetMouseLocation(); held["MX"]=mp.X; held["MY"]=mp.Y
            table.insert(Rec.Frames,held); updRecStatus()
        end)
    end
end)
local playBtn=mkBtn(RECORDER_PAGE,"play once",BLUE,4)
playBtn.MouseButton1Click:Connect(function()
    if #Rec.Frames==0 then return end
    if Rec.Playing then stopAll(); playBtn.Text="play once"; return end
    stopAll(); Rec.Playing=true; Rec.PlayIdx=0; Rec.PrevHeld={}; Rec.CurrentRep=1; Rec.RepeatCount=1
    playBtn.Text="stop"
    Rec.Conn=RunService.RenderStepped:Connect(function()
        if not Rec.Playing then return end
        Rec.PlayIdx+=1
        if Rec.PlayIdx>#Rec.Frames then stopAll(); playBtn.Text="play once"; return end
        local frame=Rec.Frames[Rec.PlayIdx]
        pcall(function() VIM:SendMouseMoveEvent(frame["MX"] or 0,frame["MY"] or 0,game) end)
        for _,kc in ipairs(WATCH_KEYS) do
            local was=Rec.PrevHeld[kc] or false; local now=frame[kc] or false
            if now and not was then fireKey(true,kc) elseif not now and was then fireKey(false,kc) end
        end
        local wasMB1=Rec.PrevHeld["MB1"] or false; local nowMB1=frame["MB1"] or false
        if nowMB1 and not wasMB1 then pcall(function() VIM:SendMouseButtonEvent(frame["MX"],frame["MY"],0,true,game,0) end)
        elseif not nowMB1 and wasMB1 then pcall(function() VIM:SendMouseButtonEvent(frame["MX"],frame["MY"],0,false,game,0) end) end
        Rec.PrevHeld=frame; updRecStatus()
    end)
end)
local loopRepBtn=mkBtn(RECORDER_PAGE,"start repeat loop",GREEN,5)
loopRepBtn.MouseButton1Click:Connect(function()
    if #Rec.Frames==0 then return end
    if Rec.Playing and Rec.Repeating then stopAll(); loopRepBtn.Text="start repeat loop"; loopRepBtn.BackgroundColor3=GREEN; return end
    stopAll(); Rec.Playing=true; Rec.Repeating=true; Rec.PlayIdx=0; Rec.PrevHeld={}; Rec.CurrentRep=1
    loopRepBtn.Text="stop loop"; loopRepBtn.BackgroundColor3=RED
    Rec.Conn=RunService.RenderStepped:Connect(function()
        if not Rec.Playing then return end
        Rec.PlayIdx+=1
        if Rec.PlayIdx>#Rec.Frames then releaseAllKeys(); Rec.PlayIdx=1; Rec.CurrentRep+=1; task.wait(0.2) end
        if Rec.PlayIdx>#Rec.Frames then return end
        local frame=Rec.Frames[Rec.PlayIdx]
        pcall(function() VIM:SendMouseMoveEvent(frame["MX"] or 0,frame["MY"] or 0,game) end)
        for _,kc in ipairs(WATCH_KEYS) do
            local was=Rec.PrevHeld[kc] or false; local now=frame[kc] or false
            if now and not was then fireKey(true,kc) elseif not now and was then fireKey(false,kc) end
        end
        local wasMB1=Rec.PrevHeld["MB1"] or false; local nowMB1=frame["MB1"] or false
        if nowMB1 and not wasMB1 then pcall(function() VIM:SendMouseButtonEvent(frame["MX"],frame["MY"],0,true,game,0) end)
        elseif not nowMB1 and wasMB1 then pcall(function() VIM:SendMouseButtonEvent(frame["MX"],frame["MY"],0,false,game,0) end) end
        Rec.PrevHeld=frame; updRecStatus()
    end)
end)
mkBtn(RECORDER_PAGE,"clear",DKGREY,6,function()
    stopAll(); Rec.Frames={}; updRecStatus()
    recBtn.Text="record"; recBtn.BackgroundColor3=DKGREY
    playBtn.Text="play once"; playBtn.BackgroundColor3=BLUE
    loopRepBtn.Text="start repeat loop"; loopRepBtn.BackgroundColor3=GREEN
end)

