local function unequipAll()
    local c=LP.Character; if not c then return end
    local hum=c:FindFirstChildOfClass("Humanoid"); if not hum then return end
    pcall(function() hum:UnequipTools() end)
    task.wait(0.15)
end

local function equipItem(name)
    local c=LP.Character; if not c then return false end
    if c:FindFirstChild(name) then return true end
    local tool=LP.Backpack:FindFirstChild(name); if not tool then return false end
    local hum=c:FindFirstChildOfClass("Humanoid"); if not hum then return false end
    pcall(function() hum:EquipTool(tool) end)
    task.wait(0.2); return c:FindFirstChild(name)~=nil
end

-- Retry equip up to CFG.retryMax times
local function equipWithRetry(name)
    for attempt=1,CFG.retryMax do
        if equipItem(name) then return true end
        setStatus("⚠ Retry equip "..name.." ("..attempt.."/"..CFG.retryMax..")")
        task.wait(0.5)
    end
    return false
end

local function waitI(secs)
    stats.stepEnd   = tick()+secs
    stats.stepTotal = secs
    local elapsed = 0
    while farmEnabled and elapsed < secs do
        task.wait(0.2); elapsed += 0.2
    end
    stats.stepEnd   = nil
    stats.stepTotal = 0
end

-- Click a button visible on screen (PlayerGui only, no shop prompt)
