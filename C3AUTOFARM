local sliderValues={}
local function sliderRow(parent,labelText,key,min,max,default,order)
    local f=frame(parent,{
        Size=UDim2.new(1,0,0,42),
        BackgroundColor3=C.surf,
        BorderSizePixel=1,
        BorderColor3=C.border,
        LayoutOrder=order,
    })
    corner(f,5)
    lbl(f,{
        Text=labelText,
        TextSize=10,
        TextColor3=C.txt,
        Size=UDim2.new(0.6,0,0,16),
        Position=UDim2.new(0,10,0,4),
    })
    local valLbl=lbl(f,{
        Text=tostring(default),
        TextSize=10,
        TextColor3=C.acc,
        Size=UDim2.new(0.4,-10,0,16),
        Position=UDim2.new(0.6,0,0,4),
        TextXAlignment=Enum.TextXAlignment.Right,
    })
    local track=frame(f,{
        Size=UDim2.new(1,-20,0,4),
        Position=UDim2.new(0,10,0,26),
        BackgroundColor3=C.mute,
        BorderSizePixel=0,
    })
    corner(track,2)
    local fill=frame(track,{
        Size=UDim2.new((default-min)/(max-min),0,1,0),
        BackgroundColor3=C.acc,
        BorderSizePixel=0,
    })
    corner(fill,2)
    local thumb=frame(track,{
        Size=UDim2.new(0,12,0,12),
        Position=UDim2.new((default-min)/(max-min),0,0.5,-6),
        BackgroundColor3=C.white,
        BorderSizePixel=0,
        ZIndex=2,
    })
    corner(thumb,6)
    -- drag
    local sliding=false
    local function update(x)
        local pct=math.clamp((x-track.AbsolutePosition.X)/track.AbsoluteSize.X,0,1)
        local val=math.floor(min+(max-min)*pct*10+0.5)/10
        fill.Size=UDim2.new(pct,0,1,0)
        thumb.Position=UDim2.new(pct,-6,0.5,-6)
        valLbl.Text=tostring(val)
        sliderValues[key]=val
        if CFG[key]~=nil then CFG[key]=val end
    end
    track.InputBegan:Connect(function(inp)
        if inp.UserInputType==Enum.UserInputType.MouseButton1 then sliding=true; update(inp.Position.X) end
    end)
    track.InputEnded:Connect(function(inp)
        if inp.UserInputType==Enum.UserInputType.MouseButton1 then sliding=false end
    end)
    UIS.InputChanged:Connect(function(inp)
        if sliding and inp.UserInputType==Enum.UserInputType.MouseMovement then update(inp.Position.X) end
    end)
    sliderValues[key]=default
    return f
end

