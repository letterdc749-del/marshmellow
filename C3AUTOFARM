-- ── MUTE SOUNDS ───────────────────────────────────────────────
local soundsMuted    = false
local origVolume     = SoundSvc.RespectFilteringEnabled and 0.5 or 0.5 -- placeholder
local mutedSounds    = {} -- store per-sound original volumes

local function setMuteSounds(enabled)
    soundsMuted = enabled
    if enabled then
        -- mute the master SoundService volume
        origVolume = SoundSvc.AmbientReverb ~= nil and 1 or 1
        pcall(function() SoundSvc.MasterVolume = 0 end) -- works in some executors
        -- also silence every Sound instance currently in game
        task.spawn(function()
            for _,s in ipairs(workspace:GetDescendants()) do
                if s:IsA("Sound") and not mutedSounds[s] then
                    mutedSounds[s] = s.Volume
                    pcall(function() s.Volume = 0 end)
                end
            end
        end)
        -- watch for new sounds and mute them
        workspace.DescendantAdded:Connect(function(d)
            if soundsMuted and d:IsA("Sound") and not mutedSounds[d] then
                task.wait() -- let it initialise
                mutedSounds[d] = d.Volume
                pcall(function() d.Volume = 0 end)
            end
        end)
    else
        -- restore master volume
        pcall(function() SoundSvc.MasterVolume = 1 end)
        -- restore individual sounds
        for s, vol in pairs(mutedSounds) do
            pcall(function() if s and s.Parent then s.Volume = vol end end)
        end
        mutedSounds = {}
    end
end

