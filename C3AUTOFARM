local WATCH_KEYS = {
    Enum.KeyCode.W, Enum.KeyCode.A, Enum.KeyCode.S, Enum.KeyCode.D,
    Enum.KeyCode.Space, Enum.KeyCode.LeftShift, Enum.KeyCode.E, Enum.KeyCode.F,
    Enum.KeyCode.One, Enum.KeyCode.Two, Enum.KeyCode.Three, Enum.KeyCode.Four,
}

local Rec = {
    Recording=false, Playing=false, Frames={}, Conn=nil,
    PlayIdx=0, Repeating=false, RepeatCount=1, CurrentRep=0, PrevHeld={},
}

local function fireKey(down,kc)
    pcall(function() VIM:SendKeyEvent(down,kc,false,game) end)
end
local function releaseAllKeys()
    for _,kc in ipairs(WATCH_KEYS) do fireKey(false,kc) end
    pcall(function()
        local mp=UIS:GetMouseLocation()
        VIM:SendMouseButtonEvent(mp.X,mp.Y,0,false,game,0)
    end)
end

