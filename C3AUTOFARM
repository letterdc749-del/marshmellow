local function switchTab(name)
    activeTab=name
    for n,tb in pairs(tabBtns) do
        local active=n==name
        tb.BackgroundColor3=active and C.surf or C.bg
        tb.TextColor3=active and C.acc or C.sub
        -- bottom indicator
