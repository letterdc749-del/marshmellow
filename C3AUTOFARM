-- ── HELPERS ───────────────────────────────────────────────────
local function jitter()
    if CFG.jitter then task.wait(math.random(5,15)/100) end
end

local lStatus -- forward declare so setStatus can write to it directly
local function setStatus(s)
    stats.status = s
    if lStatus then pcall(function() lStatus.Text="status: "..s end) end
    if s ~= lastStatus then
        lastStatus = s
        lastStatusChange = tick()
    end
end

local function getSizeFromName(name)
    local n=name:lower()
    if n:find("large") then return "Large"
    elseif n:find("medium") then return "Medium"
    elseif n:find("small") then return "Small"
    else return "Small" end
end

local function countInv(name)
    local n=0
    local search=name:lower():gsub("%s+","")
    pcall(function()
        for _,v in ipairs(LP.Backpack:GetChildren()) do
            if v:IsA("Tool") and v.Name:lower():gsub("%s+","")==search then n+=1 end
        end
        if LP.Character then
            for _,v in ipairs(LP.Character:GetChildren()) do
                if v:IsA("Tool") and v.Name:lower():gsub("%s+","")==search then n+=1 end
            end
        end
    end)
    return n
end

local function getMarshmallows()
    local items={}
    local function scan(c) if not c then return end
        for _,v in ipairs(c:GetChildren()) do
            if v:IsA("Tool") then
                local n=v.Name:lower()
                if n:find("marshmallow") or n:find("marsh") then table.insert(items,v) end
            end
        end
    end
    scan(LP.Backpack); if LP.Character then scan(LP.Character) end
    return items
end

local function countMarshmallowInv()
    return #getMarshmallows()
end

local function directTP(pos)
    local c=LP.Character; if not c then return end
    local r=c:FindFirstChild("HumanoidRootPart"); if not r then return end
    r.CFrame=CFrame.new(pos); r.AssemblyLinearVelocity=Vector3.zero
end

local function pressE()
