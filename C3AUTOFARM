-- ── BETTER STAT UPDATE — direct refs ──────────────────────────
-- Re-do statRow to return val label directly
local function setStatLabel(key,val)
    if statLabels[key] then statLabels[key].Text=tostring(val) end
end

-- Override live loop properly:
task.spawn(function()
    while SG.Parent do
        local now=tick()
        -- step bar
        if stats.stepEnd then
            local rem=math.max(0,stats.stepEnd-now)
            local tot=math.max(stats.stepTotal,1)
            local pct=math.clamp(1-rem/tot,0,1)
            stepFill.Size=UDim2.new(pct,0,1,0)
            stepLbl.Text=string.format("step: %.1fs",rem)
            stepPct.Text=string.format("%d%%",math.floor(pct*100))
            stepLbl.TextColor3=rem<5 and C.red or C.acc
        else
            stepFill.Size=UDim2.new(0,0,1,0)
            stepLbl.Text="step: --"; stepPct.Text=""
        end
        -- cook
        if stats.cookStart then
            local e=math.floor(now-stats.cookStart)
            setStatLabel("cooktime",string.format("%d:%02d",math.floor(e/60),e%60))
        else setStatLabel("cooktime","--") end
        -- avg
        if stats.cookCount and stats.cookCount>0 then
            local avg=math.floor(stats.totalCookSecs/stats.cookCount)
            setStatLabel("avgcook",string.format("%d:%02d",math.floor(avg/60),avg%60))
        else setStatLabel("avgcook","--") end
        -- uptime
        local s=math.floor(stats.farmUptime+(stats.farmStarted and now-stats.farmStarted or 0))
        setStatLabel("uptime",string.format("%d:%02d",math.floor(s/60),s%60))
        -- counts
        setStatLabel("small",stats.small)
        setStatLabel("medium",stats.medium)
        setStatLabel("large",stats.large)
        -- mini stats
        if miniStatLabels["batches"] then miniStatLabels["batches"].Text=tostring(stats.batches) end
        if miniStatLabels["earned"]  then miniStatLabels["earned"].Text="$"..tostring(stats.earned) end
        if miniStatLabels["inbag"]   then miniStatLabels["inbag"].Text=tostring(countMarshmallowInv()) end
        if miniStatLabels["failed"]  then miniStatLabels["failed"].Text=tostring(stats.failed) end
        -- status badge
        if farmEnabled then
            titleBadge.BackgroundColor3=loopEnabled and Color3.fromRGB(20,40,100) or Color3.fromRGB(20,80,30)
            titleBadgeLbl.Text=loopEnabled and "loop" or "farm"
            titleBadgeLbl.TextColor3=loopEnabled and C.blue or C.green
        else
            titleBadge.BackgroundColor3=C.mute
            titleBadgeLbl.Text="idle"
            titleBadgeLbl.TextColor3=C.sub
        end
        -- push status to log on change
        if lStatus_main.Text~=stats.status then
            lStatus_main.Text=stats.status
            pushLog(stats.status)
        end
        refreshInv()
        task.wait(0.2)
    end
end)

