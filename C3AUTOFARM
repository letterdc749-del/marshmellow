recBtn_clear.MouseButton1Click:Connect(function()
    Rec.Frames={}; Rec.PlayIdx=0
    recStatusLbl.Text="frames: 0  |  status: cleared"
end)

recBtn_rec.MouseButton1Click:Connect(function()
    if Rec.Recording then
        Rec.Recording=false; if Rec.Conn then Rec.Conn:Disconnect(); Rec.Conn=nil end
        recBtn_rec.Text="⏺ rec"; recBtn_rec.BackgroundColor3=C.red
        recStatusLbl.Text="frames: "..#Rec.Frames.."  |  status: done"
    else
        Rec.Frames={}; Rec.Recording=true
        recBtn_rec.Text="⏹ stop"; recBtn_rec.BackgroundColor3=C.orange
        recStatusLbl.Text="frames: 0  |  status: recording..."
        Rec.Conn=RunService.RenderStepped:Connect(function()
            if not Rec.Recording then return end
            local held={}
            for _,kc in ipairs(WATCH_KEYS) do
                held[tostring(kc)]=UIS:IsKeyDown(kc)
            end
            local mp=UIS:GetMouseLocation()
            table.insert(Rec.Frames,{held=held,mx=mp.X,my=mp.Y,mb1=UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)})
            recStatusLbl.Text="frames: "..#Rec.Frames.."  |  status: recording..."
        end)
    end
end)

recBtn_play.MouseButton1Click:Connect(function()
    if #Rec.Frames==0 then return end
    task.spawn(function()
        for _,frame in ipairs(Rec.Frames) do
            for kc_str,down in pairs(frame.held) do
                local ok,kc=pcall(function() return Enum.KeyCode[kc_str:gsub("Enum.KeyCode.","")] end)
                if ok and kc then fireKey(down,kc) end
            end
            if frame.mb1 then VIM:SendMouseButtonEvent(frame.mx,frame.my,0,true,game,0) end
            task.wait(1/60)
        end
        releaseAllKeys()
        recStatusLbl.Text="frames: "..#Rec.Frames.."  |  status: done"
    end)
end)

recBtn_rep.MouseButton1Click:Connect(function()
    if Rec.Repeating then
        Rec.Repeating=false
        recBtn_rep.BackgroundColor3=Color3.fromRGB(30,60,130)
        recBtn_rep.Text="🔁 loop"
    else
        if #Rec.Frames==0 then return end
        Rec.Repeating=true
        recBtn_rep.BackgroundColor3=C.red
        recBtn_rep.Text="⏹ stop"
        task.spawn(function()
            while Rec.Repeating do
                for _,fr in ipairs(Rec.Frames) do
                    if not Rec.Repeating then break end
                    for kc_str,down in pairs(fr.held) do
                        local ok,kc=pcall(function() return Enum.KeyCode[kc_str:gsub("Enum.KeyCode.","")] end)
                        if ok and kc then fireKey(down,kc) end
                    end
                    task.wait(1/60)
                end
                releaseAllKeys(); task.wait(0.2)
            end
        end)
    end
end)

