local function logBatch(size)
    table.insert(stats.batchLog, 1, size)
    if #stats.batchLog>5 then table.remove(stats.batchLog) end
    stats.lastBatch=size
end

-- ── PERSISTENT MARSHMALLOW WATCHER ────────────────────────────
local selling = false -- true while doSell is running, blocks watcher

local function onMSAdded(item)
    if not item:IsA("Tool") then return end
    local n=item.Name:lower()
    if not (n:find("marshmallow") or n:find("marsh")) then return end
    if farmEnabled then return end -- farm handles its own counting
    if selling then return end     -- ignore items moving around during sell
    local size = getSizeFromName(item.Name)
    if size=="Large" then stats.large+=1
    elseif size=="Medium" then stats.medium+=1
    else stats.small+=1 end
    stats.batches+=1
    logBatch(size)
    setStatus("✅ Got "..size.." MS! ("..item.Name..")")
end

